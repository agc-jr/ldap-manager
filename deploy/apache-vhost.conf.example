# Exemplo de VirtualHost para o AD Manager Web.
# Ajuste ServerName, DocumentRoot, caminhos do certificado e a faixa de IP.
#
# Por que HTTPS mesmo numa rede interna: a ferramenta transmite senhas do
# domínio — a de quem opera e cada senha definida ou redefinida para usuários
# do AD. Em HTTP elas trafegam em texto claro, legíveis para qualquer máquina
# que veja o tráfego da rede. Além disso, o cookie de sessão só recebe a flag
# Secure sob HTTPS.
#
# Certificado emitido por uma CA pública (Let's Encrypt e afins): se o nome
# aponta para um IP privado, como costuma ser o caso de uma ferramenta interna,
# o desafio HTTP-01 NÃO funciona — a CA não consegue alcançar o servidor pela
# internet. Use o desafio DNS-01, que valida por registro TXT e não depende de
# o serviço ser acessível de fora:
#
#   certbot certonly --manual --preferred-challenges dns \
#     -d ad-manager.interno.local
#
# Com DNS-01 manual a renovação também é manual, a cada 90 dias. Se o seu
# provedor de DNS tiver API, o plugin correspondente (certbot-dns-*) automatiza
# isso; sem ele, um wildcard já emitido para o domínio costuma ser o caminho
# mais tranquilo.
#
# Se você ainda não tem certificado, um autoassinado já cifra o tráfego (o
# navegador vai avisar na primeira visita):
#
#   openssl req -x509 -nodes -days 825 -newkey rsa:2048 \
#     -keyout /etc/ssl/private/ldap-manager.key \
#     -out    /etc/ssl/certs/ldap-manager.crt \
#     -subj "/CN=ad-manager.interno.local" \
#     -addext "subjectAltName=DNS:ad-manager.interno.local"

# HTTP existe apenas para redirecionar.
<VirtualHost *:80>
    ServerName ad-manager.interno.local

    RewriteEngine On
    RewriteRule ^(.*)$ https://%{HTTP_HOST}$1 [R=301,L]

    ErrorLog ${APACHE_LOG_DIR}/ldap-manager-error.log
    CustomLog ${APACHE_LOG_DIR}/ldap-manager-access.log combined
</VirtualHost>

<VirtualHost *:443>
    ServerName ad-manager.interno.local
    DocumentRoot /var/www/ldap-manager/public

    SSLEngine on
    SSLCertificateFile    /etc/ssl/certs/ldap-manager.crt
    SSLCertificateKeyFile /etc/ssl/private/ldap-manager.key
    # SSLCertificateChainFile /etc/ssl/certs/ldap-manager-chain.crt

    SSLProtocol -all +TLSv1.2 +TLSv1.3
    SSLHonorCipherOrder off

    <Directory /var/www/ldap-manager/public>
        Options -Indexes +FollowSymLinks
        AllowOverride None

        # Restringe à rede interna (ajuste a faixa)
        Require ip 10.0.0.0/8
        Require ip 127.0.0.1
    </Directory>

    # Nada fora de public/ deve ser acessível: config/, src/, sql/, bin/ e .git
    <DirectoryMatch "^/var/www/ldap-manager/(?!public)">
        Require all denied
    </DirectoryMatch>

    # Comece com max-age curto e só aumente quando a renovação do certificado
    # estiver comprovada: durante o período anunciado o navegador recusa HTTP
    # neste domínio, e voltar atrás exige limpar o estado em cada máquina.
    Header always set Strict-Transport-Security "max-age=300"

    ServerSignature Off

    ErrorLog ${APACHE_LOG_DIR}/ldap-manager-ssl-error.log
    CustomLog ${APACHE_LOG_DIR}/ldap-manager-ssl-access.log combined
</VirtualHost>
